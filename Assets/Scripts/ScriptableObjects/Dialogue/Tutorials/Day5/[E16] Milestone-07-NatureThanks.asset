  npcImage: {fileID: 21300000, guid: 13062ce599809b74db8286a76d7b2edd, type: 3}
  dialogueText: "Ja muista - terve kosteikko kiitt\xE4\xE4 sinua kurnutuksella, liverryksell\xE4
    ja kirkkaalla vedell\xE4. "
  dialogueTextLocalized:
    fi: "Ja muista - terve kosteikko kiitt\xE4\xE4 sinua kurnutuksella, liverryksell\xE4
      ja kirkkaalla vedell\xE4. "
    sw: "Och kom ih\xE5g, en frisk v\xE5tmark tackar dig med kv\xE4kande grodor,
      f\xE5gels\xE5ng och klart vatten.\n"
    en: And remember - a healthy wetland thanks you with croaks, birdsongs and clear
      water.
