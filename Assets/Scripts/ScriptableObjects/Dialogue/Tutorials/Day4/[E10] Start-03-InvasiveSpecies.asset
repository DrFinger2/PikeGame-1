  npcImage: {fileID: 21300000, guid: 13062ce599809b74db8286a76d7b2edd, type: 3}
  dialogueText: "Jotkut kasvit levi\xE4v\xE4t liian nopeasti ja syrj\xE4ytt\xE4v\xE4t
    alkuper\xE4iset lajit. N\xE4it\xE4 lajeja t\xE4\xE4ll\xE4 kosteikolla on muun
    muassa j\xE4ttipalsami, lupiini, isosorsimo ja lammikki."
  dialogueTextLocalized:
    fi: "Jotkut kasvit levi\xE4v\xE4t liian nopeasti ja syrj\xE4ytt\xE4v\xE4t alkuper\xE4iset
      lajit. N\xE4it\xE4 lajeja t\xE4\xE4ll\xE4 kosteikolla on muun muassa j\xE4ttipalsami,
      lupiini, isosorsimo ja lammikki."
    sw: "H\xE4r i v\xE5tmarken g\xE4ller det bland annat j\xE4ttebalsamin, lupin,
      j\xE4ttegr\xF6e och sj\xF6gull."
    en: 'Some plants spread too quickly and push out native species. In this wetland,
      these include Himalayan balsam, lupine, reed-grass and fringed water-lily.

'
