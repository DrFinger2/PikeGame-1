  responseTextLocalized:
    fi: "Lis\xE4\xE4t monipuolisia kosteikkokasveja, joissa hy\xF6nteiset voivat
      lis\xE4\xE4nty\xE4."
    sw: "Du l\xE4gger till m\xE5ngsidiga v\xE5tmarksv\xE4xter och grunda vattenomr\xE5den
