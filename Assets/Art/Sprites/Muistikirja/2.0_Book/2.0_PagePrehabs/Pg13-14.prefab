  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<align=center><b>RUO\u2019OT</b></align>\n\nRuo\u2019ot ovat kosteikon
    t\xE4rkeimpi\xE4 kasveja. Ne sitovat ravinteita, puhdistavat vett\xE4 ja tarjoavat
    suojaa monille el\xE4imille. Lis\xE4ksi ne est\xE4v\xE4t eroosiota.\n\n\n\n\n\nJ\xE4rviruoko\n\nJ\xE4rviruoko
    on korkea \nkasvi, joka muodostaa \ntiheit\xE4 ruovikkoja rannoille. \nSe levi\xE4\xE4
    tehokkaasti \njuurakon avulla ja \nviihtyy reheviss\xE4 vesiss\xE4."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 32d633b021bddaa4785f5f8115e93e16, type: 2}
  m_sharedMaterial: {fileID: 6471187536760470386, guid: 32d633b021bddaa4785f5f8115e93e16, type: 2}
