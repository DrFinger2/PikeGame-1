      m_Calls: []
  m_text: "\nLupiini\n\nLupiini on korkea kasvi, jolla on sinisen, vaaleanpunaisen
    tai valkoisen kirjava kukinto. Se kasvaa usein tienvarsilla ja niityill\xE4,
    mutta levi\xE4\xE4 my\xF6s kosteikkojen l\xE4heisyyteen, miss\xE4 se rikastaa
    maaper\xE4\xE4 typell\xE4 ja syrj\xE4ytt\xE4\xE4 muita lajeja.\r\n"
  m_isRightToLeft: 0
