  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "J\xE4rvikaisla\n\nJ\xE4rvikaisla on lehdet\xF6n ja \npaksuvartinen kasvi,
    joka \nsekoitetaan usein \nj\xE4rviruokoon. Sen ruskeat \nkukinnot kasvavat pienin\xE4
    \nryhmin\xE4. Se kasvaa \nj\xE4rviss\xE4 ja v\xE4h\xE4suolaisissa \nmurtovesiss\xE4.\n\n\nOsmank\xE4\xE4mi\n\nSuomessa
    kasvaa kahta \nosmank\xE4\xE4milajia: leve\xE4- ja \nkapeaosmank\xE4\xE4mi. Ne
    ovat \nkorkeita kasveja, joilla on \npaksut varret ja tiivis \nkukinto, ja ne
    kasvavat\n matalassa vedess\xE4."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 32d633b021bddaa4785f5f8115e93e16, type: 2}
  m_sharedMaterial: {fileID: 6471187536760470386, guid: 32d633b021bddaa4785f5f8115e93e16, type: 2}
  m_fontSharedMaterials: []
  m_fontMaterial: {fileID: 0}
  m_fontMaterials: []
