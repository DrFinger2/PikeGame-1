  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "J\xE4rvikaisla\n\nJ\xE4rvikaisla on lehdet\xF6n ja paksuvartinen kasvi,
    joka sekoitetaan usein j\xE4rviruokoon. Sen ruskeat kukinnot kasvavat pienin\xE4
    ryhmin\xE4. Se kasvaa j\xE4rviss\xE4 ja v\xE4h\xE4suolaisissa murtovesiss\xE4.\n\n\n\nOsmank\xE4\xE4mi\n\nSuomessa
    kasvaa kahta \nosmank\xE4\xE4milajia: leve\xE4- ja \nkapeaosmank\xE4\xE4mi. Ne
    ovat \nkorkeita kasveja, joilla on paksut varret ja tiivis kukinto, ja ne kasvavat
    matalassa vedess\xE4."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 32d633b021bddaa4785f5f8115e93e16, type: 2}
  m_sharedMaterial: {fileID: 6471187536760470386, guid: 32d633b021bddaa4785f5f8115e93e16, type: 2}
  m_fontSharedMaterials: []
