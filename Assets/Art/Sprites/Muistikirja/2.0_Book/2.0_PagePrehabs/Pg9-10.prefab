      m_Calls: []
  m_text: "<align=center><b>EL\xC4IMET JA HY\xD6NTEISET</b></align>\n\n\nSupikoira\u200B\r\n\r\nSupikoira
    on pienikokoinen ja pitk\xE4karvainen koirael\xE4in, joka sy\xF6 sek\xE4 el\xE4in-
    ett\xE4 kasviravintoa ja voi vaipua talviuneen. Kosteikoilla supikoira aiheuttaa
    paljon vahinkoa. Se sy\xF6 lintujen munia ja poikasia, voi levitt\xE4\xE4 tauteja
    ja lis\xE4\xE4ntyy nopeasti. T\xE4m\xE4n vuoksi se voi uhata alueen luonnon tasapainoa.\u200B"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 32d633b021bddaa4785f5f8115e93e16, type: 2}
  m_sharedMaterial: {fileID: 6471187536760470386, guid: 32d633b021bddaa4785f5f8115e93e16, type: 2}
  m_fontSharedMaterials: []
  m_fontMaterial: {fileID: 0}
