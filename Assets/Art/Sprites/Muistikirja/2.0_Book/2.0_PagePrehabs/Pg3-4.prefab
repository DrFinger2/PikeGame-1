--- !u!114 &3672585401738819244
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1680277126811690134}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b>Tietoa hauesta\u200B</b>\r\n\r\nHauki on petokala, lonka pituus on
    40-120cm ja sen paino noin 0,5-15kg. \n\nHauella on suuri kita ja ter\xE4v\xE4t
    hampaat, joista sen tunnistaa helposti.\n\r\nHauen kyljet ovat vihre\xE4t, vatsa
    vaalea, selk\xE4 musta ja sen kyljiss\xE4 on t\xE4pli\xE4, jotka yhdistyv\xE4t
    raidoiksi.\n\r\nHauet kutevat varhain kev\xE4\xE4ll\xE4 ja ne vaeltavat heti
    j\xE4iden l\xE4hd\xF6n \xE4lkeen joukolla mataliin ruokoisiin lahtiin tai tulvaniityille.\n\r\nMerialueilla
    kutu tapahtuu v\xE4h\xE4n my\xF6hemmin. \u200B"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 32d633b021bddaa4785f5f8115e93e16, type: 2}
  m_sharedMaterial: {fileID: 6471187536760470386, guid: 32d633b021bddaa4785f5f8115e93e16, type: 2}
  m_fontSharedMaterials: []
