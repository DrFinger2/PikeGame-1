--- !u!114 &3927925753585208204
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 3752300061302600148}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b>Hauki ja kosteikko\u200B</b>\n\nKosteikko on hyv\xE4 kutemisymp\xE4rist\xF6
    hauille, sill\xE4 kosteikot ovat matalia ja niiss\xE4 kasvaa ruokoja ja muita
    kasveja\r\nmelko tihe\xE4sti. \n\nKosteikko luo my\xF6s hyv\xE4n elinymp\xE4rist\xF6n
    hauen poikasille kasvaa. \n\nKosteikkoja kunnollistamalla pystyt\xE4\xE4nkin
    nostamaan mahdollisesti\r\nhaukikantoja, sill\xE4 kosteikot tarjoavat hyv\xE4n
    lis\xE4\xE4ntymis- ja kasvuymp\xE4rist\xF6n hauille."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 32d633b021bddaa4785f5f8115e93e16, type: 2}
  m_sharedMaterial: {fileID: 6471187536760470386, guid: 32d633b021bddaa4785f5f8115e93e16, type: 2}
