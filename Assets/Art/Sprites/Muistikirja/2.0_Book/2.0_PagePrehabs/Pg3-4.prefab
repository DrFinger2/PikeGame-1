      m_Calls: []
  m_text: "Hauet ovat t\xE4rke\xE4ss\xE4 asemassa muiden kalakantojen, kuten s\xE4rkien
    hillitsemisess\xE4, sill\xE4 ne saalistavat monia kalalajeja.\n\nNyky\xE4\xE4n
    hauen kanta on laskussa, koska monia hauelle t\xE4rkeit\xE4 elinymp\xE4rist\xF6j\xE4
    ja kutupaikkoja on tuhottu ihmisten toimesta.\u200B"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 32d633b021bddaa4785f5f8115e93e16, type: 2}
  m_sharedMaterial: {fileID: 6471187536760470386, guid: 32d633b021bddaa4785f5f8115e93e16, type: 2}
