  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Pikkukalat\n\nPikkukalat ovat t\xE4rke\xE4 osa kosteikon el\xE4m\xE4\xE4.
    Niihin kuuluvat esimerkiksi s\xE4rjen poikaset sek\xE4 ahvenen nuoret yksil\xF6t.
    Ne sy\xF6v\xE4t planktonia ja pieni\xE4 selk\xE4rangattomia el\xE4imi\xE4 ja
    toimivat itse ravintona suuremmille kaloille. Esimerkiksi hauki saalistaa pikkukaloja,
    mik\xE4 auttaa pit\xE4m\xE4\xE4n kalakannat tasapainossa.\r\n\u200B"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 32d633b021bddaa4785f5f8115e93e16, type: 2}
  m_sharedMaterial: {fileID: 6471187536760470386, guid: 32d633b021bddaa4785f5f8115e93e16, type: 2}
