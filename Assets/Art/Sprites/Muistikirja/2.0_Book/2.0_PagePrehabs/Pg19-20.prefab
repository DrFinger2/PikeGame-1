  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 36422ed2236b4ef4d88887b861d3bdcc, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  buttonText:
    fi: "Uistinvita\n\nUistinvidalla on soikeat lehdet, jotka kelluvat veden pinnalla
      sek\xE4 vihre\xE4, t\xE4hk\xE4m\xE4inen kukinto, joka nousee veden yl\xE4puolelle.
      Se viihtyy reheviss\xE4 vesiss\xE4."
    sw: "G\xE4ddnate\n\nG\xE4ddnaten har avl\xE5nga blad som flyter p\xE5 vattenytan
      samt en gr\xF6n, axliknande blomst\xE4llning som str\xE4cker sig upp \xF6ver
      vattenytan. Den trivs i n\xE4ringsrika vatten."
    en: 'Floating pondweed


      The floating pondweed has oval leaves that float
      on the water''s surface and a green, spike-like inflorescence that rises above
      the water. It thrives in nutrient-rich waters.'
