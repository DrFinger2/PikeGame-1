      m_Calls: []
  m_text: "<align=center><b>UPOSLEHTISET KASVIT</b></align>\n\nUposlehtiset kasvit
    kasvavat veden alla. Ne tuottavat happea, sitovat ravinteita, pit\xE4v\xE4t veden
    kirkkaana ja tarjoavat suojaa kaloille ja pieneli\xF6ille.\n\n\u200B\nNuottaruoho\n\nNuottaruoho
    kasvaa enimm\xE4kseen veden alla, mutta sen kukinto nousee pinnalle. Se viihtyy
    kirkkaissa ja v\xE4h\xE4ravinteisissa j\xE4rviss\xE4."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 32d633b021bddaa4785f5f8115e93e16, type: 2}
  m_sharedMaterial: {fileID: 6471187536760470386, guid: 32d633b021bddaa4785f5f8115e93e16, type: 2}
