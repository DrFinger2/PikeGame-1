{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "1800cfa913fa4b02841ac49e2dc6c2a4",
    "m_Group": {
        "m_Id": "5639a5bd437e42389c0cd020323a92c2"
    },
    "m_Name": "Fresnel (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -944.0000610351563,
            "y": 1137.0,
            "width": 208.0,
            "height": 325.9998779296875
        }
    },
    "m_Slots": [
        {
            "m_Id": "73a50123204d4aaabcdbf93410520667"
        },
        {
            "m_Id": "4eba05f35f584ea7a35725dce16dea73"
        },
        {
            "m_Id": "94bd5d5319284bed9297b50ae051013d"
        },
        {
            "m_Id": "2799d52c986e40439af6837c6ea1f572"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": true,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "Fresnel",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "// Calculate base reflectivity from IOR\r\n    float f0 = pow((1.0 - IOR) / (1.0 + IOR), 2.0);\r\n    \r\n    // Angle attenuation\r\n    float dotNV = saturate(dot(normalize(Normal), normalize(ViewDir)));\r\n    float x = 1.0 - dotNV;\r\n    \r\n    // Optimized x^4 for mobile\r\n    float x2 = x * x;\r\n    float x4 = x2 * x2;\r\n    \r\n    Out = f0 + (1.0 - f0) * x4;"
}

